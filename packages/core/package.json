    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "default": "./dist/ports.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./navigator": {
      "types": "./dist/navigator.d.ts",
      "default": "./dist/navigator.js"
    },
    "./reply-suggestion": {
      "types": "./dist/reply-suggestion.d.ts",
      "default": "./dist/reply-suggestion.js"
    },
    "./navigator-provider": {
      "types": "./dist/navigator-provider.d.ts",
