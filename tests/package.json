{
  "name": "@space/tests",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "navigator:eval": "node --env-file-if-exists=../.env --import tsx evaluation/navigator-cli.ts",
    "test": "tsx --test --test-concurrency=4 contracts/*.test.ts integration/*.test.ts",
    "test:contracts": "tsx --test contracts/*.test.ts",
    "test:foundation": "tsx --test contracts/*.test.ts integration/foundation.test.ts",
    "test:workspace": "tsx --test contracts/workspace.test.ts integration/workspace.test.ts integration/user-provisioning.test.ts integration/workspace-isolation.test.ts",
    "test:chat": "tsx --test integration/chat.test.ts integration/chat-outbox.test.ts integration/chat-partitions.test.ts integration/redis-adapter.test.ts",
    "test:auth": "tsx --test integration/auth.test.ts",
    "test:assets": "tsx --test integration/assets.test.ts storage/assets.test.ts",
    "test:search": "tsx --test contracts/search.test.ts contracts/typesense.test.ts integration/search.test.ts",
    "test:search:e2e": "tsx --test e2e/search.test.ts",
    "test:calls": "tsx --test contracts/calling.test.ts integration/calling.test.ts integration/calling-realtime.test.ts",
    "test:calls:e2e": "tsx --test e2e/calling.test.ts",
    "test:huddles": "tsx --test integration/huddles.test.ts integration/huddles-realtime.test.ts",
    "test:huddles:media": "tsx --test e2e/huddles-media.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@space/contracts": "workspace:*",
    "@space/core": "workspace:*",
    "@space/event-service": "workspace:*",
    "@space/events": "workspace:*",
    "@space/mock": "workspace:*",
    "@space/postgres": "workspace:*",
    "@space/redis": "workspace:*",
    "@space/server": "workspace:*",
    "nats": "2.29.3",
    "pg": "^8.23.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@livekit/rtc-node": "1.2.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
