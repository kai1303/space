{
  "name": "@space/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node dist/main.js",
    "test": "pnpm build && node --test agent-connectors.test.mjs storage.test.mjs previews.test.mjs pdf-thumbnail.test.mjs pdf-text.test.mjs invitation-email.test.mjs calling-config.test.mjs huddle-media.test.mjs request-metrics.test.mjs live-receipts.test.mjs",
    "test:storage": "pnpm build && node --test storage.integration.test.mjs",
    "search:backfill": "node dist/search-backfill.js"
  },
  "exports": {
    "./huddles": {
      "types": "./dist/huddles.d.ts",
      "default": "./dist/huddles.js"
    },
    "./huddle-media": {
      "types": "./dist/huddle-media.d.ts",
      "default": "./dist/huddle-media.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./pdf-text": {
      "types": "./dist/pdf-text.d.ts",
      "default": "./dist/pdf-text.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./memory-index": {
      "types": "./dist/memory-index.d.ts",
      "default": "./dist/memory-index.js"
    },
    "./markdown-memory": {
      "types": "./dist/markdown-memory.d.ts",
      "default": "./dist/markdown-memory.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./typesense": {
      "types": "./dist/typesense.d.ts",
      "default": "./dist/typesense.js"
    },
    "./search-query": {
      "types": "./dist/search-query.d.ts",
      "default": "./dist/search-query.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-presigned-post": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@better-auth/drizzle-adapter": "1.7.15",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@prometheus-io/client": "0.16.1",
    "@space/contracts": "workspace:*",
    "@space/core": "workspace:*",
    "@space/events": "workspace:*",
    "@space/postgres": "workspace:*",
    "@space/redis": "workspace:*",
    "@space/workflows": "workspace:*",
    "better-auth": "1.7.15",
    "fastify": "^5.12.8",
    "file-type": "^22.3.0",
    "jose": "6.2.15",
    "livekit-server-sdk": "2.19.2",
    "nodemailer": "^10.3.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "strtok3": "^10.7.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
