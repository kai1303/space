{
  "name": "@space/mcp-gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "tsx --test *.test.ts"
  },
  "exports": {
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "default": "./dist/remote.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@space/contracts": "workspace:*",
    "@space/postgres": "workspace:*",
    "ajv": "8.20.0",
    "fastify": "^5.12.8",
    "ipaddr.js": "2.5.0",
    "pg-logical-replication": "2.6.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@types/node": "22",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
