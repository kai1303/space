{
  "name": "@space/desktop",
  "productName": "Space",
  "version": "0.1.0",
  "description": "Space desktop client for macOS",
  "author": "Space contributors",
  "license": "MIT",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "node --check src/main.cjs && node --check src/window.cjs && node --check src/policy.cjs && node --check forge.config.cjs",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node test/smoke.cjs",
    "test:live": "node test/smoke.cjs live",
    "package": "electron-forge package --platform=darwin",
    "make": "electron-forge make --platform=darwin"
  },
  "config": { "forge": "./forge.config.cjs" },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "electron": "45.2.2"
  }
}
