{
  "name": "@space/desktop",
  "productName": "Space",
  "version": "0.1.0",
  "description": "Space desktop client for macOS",
  "author": "Space contributors",
  "license": "MIT",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "node scripts/build-browser-style.cjs && node scripts/build-runner.cjs && electron .",
    "build": "node --check src/main.cjs && node --check src/window.cjs && node --check src/policy.cjs && node --check forge.config.cjs && node scripts/build-browser-style.cjs && node scripts/build-runner.cjs",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "node test/smoke.cjs",
    "test:browser": "node scripts/build-browser-style.cjs && node test/smoke.cjs browser",
    "test:live": "node test/smoke.cjs live",
    "package": "electron-forge package --platform=darwin",
    "make": "electron-forge make --platform=darwin"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@fontsource/lato": "^5.3.0",
    "@space/ui": "workspace:*",
    "@xterm/xterm": "6.0.0",
    "electron": "45.2.2",
    "esbuild": "0.28.2",
    "motion": "^14.9.0"
  }
}
