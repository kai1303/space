{
  "uid": "space-operations",
  "title": "Space operations",
  "schemaVersion": 39,
  "tags": [
    "space"
  ],
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 7,
      "title": "Chat messages per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "space-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(space_chat_messages_created_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "space-prometheus"
          },
          "legendFormat": "Messages/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: msg/s"
        },
        "overrides": []
      },
      "description": "Newly committed messages observed by the CDC bridge, averaged over five minutes. A delayed bridge reports the backlog as it catches up."
    },
    {
      "id": 8,
      "title": "Time to first confirmed receipt",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "space-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(space_chat_live_confirmed_receipt_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "space-prometheus"
          },
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(space_chat_live_confirmed_receipt_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "space-prometheus"
          },
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(space_chat_live_confirmed_receipt_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "space-prometheus"
          },
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "From the sender submitting a send, including time in its local queue, until a different account confirms live receipt. Only confirmed samples contribute."
    },
    {
      "id": 9,
      "title": "Receipt sample outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "space-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(space_chat_live_receipt_samples_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "space-prometheus"
          },
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Estimated number of samples by outcome in the last five minutes. Timeouts include sends without a live recipient."
    },
    {
      "id": 10,
      "title": "Agent turn phases",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "space-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"space-(server|worker)\"} | json | msg=\"agent_turn_phase\"",
          "datasource": {
            "type": "loki",
            "uid": "space-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Use Explore to filter by traceId and follow one turn through dispatch, execution and outcome."
    },
    {
      "id": 1,
      "title": "API readiness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "space-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "space_api_ready",
          "datasource": {
            "type": "prometheus",
            "uid": "space-prometheus"
          },
          "legendFormat": "Ready (1 = yes)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Oldest unpublished event",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "space-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "space_cdc_outbox_oldest_age_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "space-prometheus"
          },
          "legendFormat": "Age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Storage available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "space-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * space_volume_available_bytes / space_volume_capacity_bytes",
          "datasource": {
            "type": "prometheus",
            "uid": "space-prometheus"
          },
          "legendFormat": "{{volume}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "API requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "space-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(space_api_http_requests_total{route!~\"/(readyz|healthz)\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "space-prometheus"
          },
          "legendFormat": "{{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Messages pending acknowledgement",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "space-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "space_jetstream_consumer_ack_pending",
          "datasource": {
            "type": "prometheus",
            "uid": "space-prometheus"
          },
          "legendFormat": "{{consumer}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Space service logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "space-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"space-(server|worker|events)\"}",
          "datasource": {
            "type": "loki",
            "uid": "space-loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
