DATABASE_URL=postgres://workplace:local_demo_only@127.0.0.1:55438/workplace
TEST_DATABASE_URL=postgres://workplace:local_demo_only@127.0.0.1:55438/workplace
API_URL=http://127.0.0.1:3000
NATS_URL=nats://127.0.0.1:54222
TEST_NATS_URL=nats://127.0.0.1:54222
REDIS_URL=redis://127.0.0.1:56380
TEST_REDIS_URL=redis://127.0.0.1:56380
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:5173
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
# Legacy operator demos only; rejected when NODE_ENV=production.
ALLOW_DEVELOPMENT_TOKENS=false
# Optional trusted AG-UI backend for connector `ag-ui`, skill `ag-ui.run`.
# AG_UI_URL=https://agent.example.com/agent
# AG_UI_TOKEN=
# Only trust the exact proxy addresses you control; blank disables proxy trust.
TRUSTED_PROXY_CIDRS=127.0.0.1,::1

# Optional absolute path for canonical Markdown channel memory.
# Unset: .space-memory at the application root. Each channel must opt in in the UI.
# MEMORY_DIRECTORY=/absolute/private/path/space-memory
# Additional MCP endpoint hostnames, comma-separated (no scheme/port).
# Loopback and configured trusted authentication-origin hosts are already allowed.
# MEMORY_MCP_ALLOWED_HOSTS=api.example.com

# Local development SeaweedFS. Unset ALL six ASSET_STORAGE_* variables to disable uploads.
# For a host-run server both endpoints are loopback; Compose overrides the internal endpoint.
ASSET_STORAGE_ENDPOINT=http://127.0.0.1:8333
ASSET_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:8333
ASSET_STORAGE_BUCKET=space-assets
ASSET_STORAGE_ACCESS_KEY=space_local_dev
ASSET_STORAGE_SECRET_KEY=space_local_dev_secret
ASSET_STORAGE_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# Optional Navigator providers. Rules-only navigation needs none of these.
# Use complete compatible Chat Completions endpoint URLs; channel managers opt in to semantic mode.
# NAVIGATOR_L1_URL=http://localhost:11434/v1/chat/completions
# NAVIGATOR_L1_MODEL=your-local-classifier
# NAVIGATOR_L1_API_KEY=
# NAVIGATOR_L2_URL=https://your-provider.example/v1/chat/completions
# NAVIGATOR_L2_MODEL=your-escalation-model
# NAVIGATOR_L2_API_KEY=

# Native TypeSafe Jev as the optional Level 1 decision provider.
# Select explicitly, then enable semantic navigation in individual channels.
# NAVIGATOR_L1_PROVIDER=jev
# TYPESAFE_API_KEY=
# NAVIGATOR_L1_MODEL=jev-latest
# Native URL defaults to https://api.typesafe.ai/v1/systemone (not /chat/completions).
# NAVIGATOR_L1_YES_THRESHOLD=0.7
# NAVIGATOR_L1_NO_THRESHOLD=0.3

# Optional workspace invitation + account-verification email delivery (SMTP).
# Manual invite links work without these. SSO and billing are not configured.
# SPACE_SMTP_HOST=smtp.example.com
# SPACE_SMTP_PORT=587
# SPACE_SMTP_SECURE=false
# SPACE_SMTP_USER=
# SPACE_SMTP_PASS=
# SPACE_SMTP_FROM=Space <noreply@example.com>
# SPACE_PUBLIC_URL=https://space.example.com
# Generate with openssl rand -hex 32; retain securely to decrypt pending invitation jobs.
# SPACE_INVITATION_ENCRYPTION_KEY=
