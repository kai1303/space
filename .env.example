DATABASE_URL=postgres://workplace:local_demo_only@127.0.0.1:55438/workplace
TEST_DATABASE_URL=postgres://workplace:local_demo_only@127.0.0.1:55438/workplace
API_URL=http://127.0.0.1:3000
REDIS_URL=redis://127.0.0.1:56380
TEST_REDIS_URL=redis://127.0.0.1:56380
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:5173
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
# Legacy operator demos only; rejected when NODE_ENV=production.
ALLOW_DEVELOPMENT_TOKENS=false
# Only trust the exact proxy addresses you control; blank disables proxy trust.
TRUSTED_PROXY_CIDRS=127.0.0.1,::1

# Optional absolute path for canonical Markdown channel memory.
# Unset: .space-memory at the application root. Each channel must opt in in the UI.
# MEMORY_DIRECTORY=/absolute/private/path/space-memory
# Additional MCP endpoint hostnames, comma-separated (no scheme/port).
# Loopback and configured trusted authentication-origin hosts are already allowed.
# MEMORY_MCP_ALLOWED_HOSTS=api.example.com

# Local development SeaweedFS. Unset ALL six ASSET_STORAGE_* variables to disable uploads.
# For a host-run server both endpoints are loopback; Compose overrides the internal endpoint.
ASSET_STORAGE_ENDPOINT=http://127.0.0.1:8333
ASSET_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:8333
ASSET_STORAGE_BUCKET=space-assets
ASSET_STORAGE_ACCESS_KEY=space_local_dev
ASSET_STORAGE_SECRET_KEY=space_local_dev_secret
ASSET_STORAGE_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
